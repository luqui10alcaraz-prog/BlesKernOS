    svga_transport_fifo_capabilities,
    svga_transport_fifo_register_count,
    svga_transport_fifo_register_read,
    svga_transport_fifo_register_write,
    svga_transport_emit,
    svga_transport_submit,
    svga_transport_wait_fence,
    svga_transport_vram_allocate,
    svga_transport_vram_free,
    svga_transport_vram_pointer,
    svga_transport_display_info
};

static uint32_t svga_runtime_capabilities(void) {
    uint32_t caps = GFX_CAP_PRESENT_BUFFER | GFX_CAP_DIRTY_RECTS |
                    GFX_CAP_BITBLT | GFX_CAP_FILL;
    uint64_t visible_end;

    if (!g_svga.active) return 0U;
    if (g_svga.cursor_hw_enabled) caps |= GFX_CAP_HW_CURSOR;
    if (svga_has_fence()) caps |= GFX_CAP_FENCE;
    visible_end = (uint64_t)g_svga.fb_offset +
                  (uint64_t)g_svga.pitch * g_svga.height;
    if (g_svga.vram_size > visible_end + SVGA_SURFACE_ALIGN)
        caps |= GFX_CAP_OFFSCREEN_VRAM;
    if (BLES_VMWARE_EXPERIMENTAL_ACCEL && g_svga.gmr_present)
        caps |= GFX_CAP_GMR;
    if (BLES_VMWARE_EXPERIMENTAL_ACCEL && g_svga.screen_defined)
        caps |= GFX_CAP_SURFACE_BLIT_HW;
    if (g_svga.capabilities & SVGA_CAP_RECT_COPY)
        caps |= GFX_CAP_BITBLT_COPY_HW;
    if (g_svga.capabilities & SVGA_CAP_RASTER_OP)
        caps |= GFX_CAP_BITBLT_ROP_HW;
    return caps;
}

static bool vmware_svga_driver_init(void) {
    static const gfx_driver_ops_t ops = {
        BK_GFX_DRIVER_ABI_VERSION,
        sizeof(gfx_driver_ops_t),
        "vmware_svga",
        200U,
        GFX_CAP_PRESENT_BUFFER | GFX_CAP_DIRTY_RECTS | GFX_CAP_HW_CURSOR |
        GFX_CAP_FENCE | GFX_CAP_OFFSCREEN_VRAM | GFX_CAP_GMR |
        GFX_CAP_BITBLT | GFX_CAP_FILL | GFX_CAP_SURFACE_BLIT_HW,
        svga_activate,
        svga_runtime_capabilities,
        svga_disable,
        svga_list_modes,
        svga_set_mode,
        svga_present_buffer,
        svga_update_rect,
        svga_flush,
        svga_wait_fence,
        svga_fill_rect,
        svga_bitblt,
        svga_cursor_define,
        svga_cursor_move,
        svga_cursor_show,
        svga_surface_create,
        svga_surface_destroy,
        svga_surface_upload,
        svga_surface_blit
    };
    if (!svga_find_device()) {
        kprintf("[SVGA.DVR] dispositivo 15AD:0405 no detectado\n");
        return false;
    }
    if (!svga_transport_register(&g_svga_transport_ops)) {
        kprintf("[SVGA.DVR] el transporte SVGA ya esta ocupado\n");
        return false;
    }
    if (!gfx_register_driver(&ops)) {
        (void)svga_transport_unregister(&g_svga_transport_ops);
        return false;
    }
    return true;
}

static void vmware_svga_driver_shutdown(void) {
    svga_disable();
    (void)svga_transport_unregister(&g_svga_transport_ops);
}

const bk_driver_module_t *bleskernos_driver_query(void) {
    static const bk_driver_module_t module = {
        BK_DRIVER_ABI_VERSION,
        sizeof(bk_driver_module_t),
        "vmware_svga",
        "VMware SVGA-II 2D: framebuffer, FIFO, BitBlt, VRAM y transporte SVGA3D",
        vmware_svga_driver_init,
        vmware_svga_driver_shutdown
    };
    return &module;
}
