+static bool r128_prepare_firmware_bootstrap(const gfx_info_t *info) {
+    uint64_t visible_end;
+
+    if (!info || info->mode != GFX_MODE_VESA_LFB ||
+        !info->framebuffer || !info->width || !info->height ||
+        !info->pitch || !info->bpp ||
+        info->width > R128_MAX_COORD || info->height > R128_MAX_COORD)
+        return false;
+
+    g_r128.vram_size = r128_read(R128_CONFIG_MEMSIZE) & 0x03FFFFFFU;
+    if (!g_r128.vram_size || info->framebuffer < g_r128.fb_bar) return false;
+
+    g_r128.fb_offset = info->framebuffer - g_r128.fb_bar;
+    if (g_r128.fb_offset & 31U) return false;
+
+    visible_end = (uint64_t)g_r128.fb_offset +
+                  (uint64_t)info->pitch * info->height;
+    if (visible_end > (uint64_t)g_r128.vram_size) return false;
+
+    g_r128.firmware_info = *info;
+    g_r128.firmware_info_valid = true;
+    g_r128.width = info->width;
+    g_r128.height = info->height;
+    g_r128.pitch = info->pitch;
+    return true;
+}
+
+static void r128_clear_32bpp_framebuffer(const gfx_info_t *info) {
+    volatile uint32_t *pixels;
+    uint32_t words_per_row;
+
+    if (!info || info->bpp != 32U || !info->framebuffer ||
+        info->pitch < (uint16_t)(info->width * 4U))
+        return;
+
+    pixels = (volatile uint32_t *)(uintptr_t)info->framebuffer;
+    words_per_row = (uint32_t)info->pitch / 4U;
+    for (uint32_t y = 0; y < info->height; y++) {
+        volatile uint32_t *row = pixels + y * words_per_row;
+        for (uint32_t x = 0; x < info->width; x++) row[x] = 0U;
+    }
+}
+
+static bool r128_bootstrap_32bpp(gfx_info_t *info,
+                                 uint16_t preferred_width,
+                                 uint16_t preferred_height) {
+    const r128_mode_t *mode;
+    uint16_t target_width;
+    uint16_t target_height;
+    uint16_t pitch;
+    uint32_t old_ext;
+    uint32_t gen;
+    uint64_t visible_end;
+    bool depth_only;
+
+    if (!info || !g_r128.display_saved) return false;
+
+    /*
+     * El primer takeover conserva siempre la resolucion y los timings que dejo
+     * el BIOS. Cambiar solamente profundidad/pitch es mucho mas seguro para el
+     * panel LVDS del portatil que reprogramar PPLL y sincronismos durante boot.
+     * preferred_* queda registrado para diagnostico; los cambios de resolucion
+     * posteriores siguen disponibles mediante set_mode().
+     */
+    target_width = info->width;
+    target_height = info->height;
+    depth_only = true;
+    mode = r128_find_mode(target_width, target_height);
+
+    pitch = (uint16_t)r128_align_up((uint32_t)target_width * 4U, 32U);
+    visible_end = (uint64_t)g_r128.fb_offset +
+                  (uint64_t)pitch * target_height;
+    if (visible_end > (uint64_t)g_r128.vram_size) {
+        kprintf("[ATIR128:TRACE] BOOT32 FAIL VRAM insuficiente need=%u have=%u\n",
+                (uint32_t)visible_end, g_r128.vram_size);
+        return false;
+    }
+
+    kprintf("[ATIR128:TRACE] BOOT32 convert %ux%ux%u pitch=%u -> %ux%ux32 pitch=%u path=%s preferred=%ux%u\n",
+            (uint32_t)info->width, (uint32_t)info->height,
+            (uint32_t)info->bpp, (uint32_t)info->pitch,
+            (uint32_t)target_width, (uint32_t)target_height,
+            (uint32_t)pitch, depth_only ? "depth-only" : "full-modeset",
+            (uint32_t)preferred_width, (uint32_t)preferred_height);
+
+    old_ext = r128_read(R128_CRTC_EXT_CNTL);
+    r128_write(R128_CRTC_EXT_CNTL, old_ext | R128_CRTC_HSYNC_DIS |
+               R128_CRTC_VSYNC_DIS | R128_CRTC_DISPLAY_DIS);
+
+    if (depth_only) {
+        /*
+         * Mantiene CRTC_H/V_* y PPLL exactamente como los configuro el BIOS.
+         * Solo cambia el formato del scanout a 32 bpp y su pitch.
+         */
+        gen = r128_read(R128_CRTC_GEN_CNTL);
+        gen = (gen & ~R128_CRTC_PIX_WIDTH_MASK) |
+              R128_CRTC_EXT_DISP_EN | R128_CRTC_EN | (6U << 8);
+        r128_write(R128_CRTC_OFFSET, g_r128.fb_offset);
+        r128_write(R128_CRTC_PITCH, (uint32_t)pitch / 32U);
+        r128_write(R128_CRTC_GEN_CNTL, gen);
+        if (r128_read(R128_CRTC_PITCH) != (uint32_t)pitch / 32U ||
+            (r128_read(R128_CRTC_GEN_CNTL) & R128_CRTC_PIX_WIDTH_MASK) !=
+                (6U << 8)) {
+            kprintf("[ATIR128:TRACE] BOOT32 FAIL CRTC no acepto profundidad/pitch\n");
+            (void)r128_restore_display(info);
+            return false;
+        }
+    } else {
+        if (!mode || !g_r128.direct_modeset_ok ||
+            !r128_program_pll(mode->pixel_khz) ||
+            !r128_write_mode_registers(mode, pitch)) {
+            kprintf("[ATIR128:TRACE] BOOT32 FAIL programacion CRTC/PPLL; restaurando firmware\n");
+            (void)r128_restore_display(info);
+            return false;
+        }
+    }
+
+    r128_write(R128_CRTC_EXT_CNTL, old_ext & ~(R128_CRTC_HSYNC_DIS |
+               R128_CRTC_VSYNC_DIS | R128_CRTC_DISPLAY_DIS));
+
+    info->mode = GFX_MODE_VESA_LFB;
+    info->framebuffer = g_r128.fb_bar + g_r128.fb_offset;
+    info->width = target_width;
+    info->height = target_height;
+    info->pitch = pitch;
+    info->bpp = 32U;
+
+    if (!r128_validate_mode(info)) {
+        kprintf("[ATIR128:TRACE] BOOT32 FAIL modo 32bpp no valido; restaurando firmware\n");
+        (void)r128_restore_display(info);
+        return false;
+    }
+
+    if (mode) g_r128.current_pixel_khz = mode->pixel_khz;
+    r128_clear_32bpp_framebuffer(info);
+    kprintf("[ATIR128:TRACE] BOOT32 OK mode=%ux%ux32 pitch=%u fb=%x timings=firmware\n",
+            (uint32_t)info->width, (uint32_t)info->height,
+            (uint32_t)info->pitch, info->framebuffer);
+    return true;
+}
