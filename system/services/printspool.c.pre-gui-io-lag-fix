typedef enum {
    LANG_TEXT = 0,
    LANG_ESCP,
    LANG_ESCP2,
    LANG_PCL5,
    LANG_POSTSCRIPT
} print_language_t;

typedef enum {
    TRANSPORT_FILE = 0,
    TRANSPORT_LPT
} print_transport_t;

typedef struct {
    char id[16];
    char name[64];
    print_language_t language;
    print_transport_t transport;
    char output_dir[BK_PATH_MAX];
    char extension[8];
    uint32_t lpt_index;
    char port_name[16];
    uint32_t dpi;
    uint8_t escp_mode;
} printer_profile_t;

typedef struct {
    uint8_t *data;
    uint32_t size;
    uint32_t capacity;
    bool failed;
} output_buffer_t;

typedef struct {
    const uint8_t *cursor;
    const uint8_t *end;
    uint32_t remaining;
} job_iterator_t;

typedef struct {
    uint16_t type;
    uint16_t flags;
    const uint8_t *payload;
    uint32_t payload_size;
} job_command_t;

typedef struct {
    uint16_t family;
